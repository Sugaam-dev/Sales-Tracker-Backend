APP_NAME=Sales tracker Portal
APP_ENV=development
SERVER_PORT=8080

# Database
DB_HOST=your_database_host
DB_PORT=5432
DB_NAME=postgres
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_SSLMODE=require

# JWT Configuration
JWT_SECRET=your_long_random_jwt_secret

# Microsoft Entra ID (Single Tenant) Credentials
AZURE_CLIENT_ID=your_azure_client_id
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_CLIENT_SECRET=your_azure_client_secret

# Token Expiry
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=168h
TEMP_TOKEN_EXPIRY=30m
MFA_PENDING_TOKEN_EXPIRY=10m

# SSO Callbacks
SSO_CALLBACK_URL=http://localhost:8080/api/v1/auth/sso/callback
FRONTEND_SSO_REDIRECT_URL=http://localhost:3000/sso-success

# Rate Limiter
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=15m

EMAIL_PROVIDER= SMTP / AZURE

# SMTP / Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_smtp_app_password

# MICROSOFT GRAPH / AZURE CONFIGURATION
AZURE_CLIENT_ID=your_azure_client_id
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_CLIENT_SECRET=your_azure_client_secret

# Microsoft 365 mailbox used as sender
MAIL_SENDER=notifications@company.com

# Logging
LOG_LEVEL=INFO