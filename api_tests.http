########################################################
### Health Check
########################################################

GET http://localhost:8080/health

###

########################################################
### SSO Login (Test this in browser first)
########################################################

# Open this in your browser to start the Microsoft SSO login flow:
# http://localhost:8080/api/v1/auth/sso/redirect

###

########################################################
### Login
########################################################

POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
    "identifier": "newuser@pmrgsolution.com",
    "password": "Welcome@123"
}

###

########################################################
### Onboarding: Set Password (First-Time Login Only)
########################################################

POST http://localhost:8080/api/v1/auth/onboarding/set-password
Content-Type: application/json

{
    "temp_token": "YOUR_TEMP_TOKEN_FROM_LOGIN",
    "new_password": "NewSecurePassword@123"
}

###

########################################################
### Onboarding: Send / Verify Email OTP
########################################################

# 1. Send OTP (omit the "otp" field)
POST http://localhost:8080/api/v1/auth/onboarding/verify-email
Content-Type: application/json

{
    "temp_token": "YOUR_TEMP_TOKEN_FROM_LOGIN"
}

###

# 2. Verify OTP (include the "otp" field)
POST http://localhost:8080/api/v1/auth/onboarding/verify-email
Content-Type: application/json

{
    "temp_token": "YOUR_TEMP_TOKEN_FROM_LOGIN",
    "otp": "123456"
}

###

########################################################
### Onboarding: Send / Verify Mobile OTP
########################################################

# 1. Send OTP (omit the "otp" field)
POST http://localhost:8080/api/v1/auth/onboarding/verify-mobile
Content-Type: application/json

{
    "temp_token": "YOUR_TEMP_TOKEN_FROM_LOGIN"
}

###

# 2. Verify OTP (include the "otp" field)
POST http://localhost:8080/api/v1/auth/onboarding/verify-mobile
Content-Type: application/json

{
    "temp_token": "YOUR_TEMP_TOKEN_FROM_LOGIN",
    "otp": "123456"
}

###

########################################################
### Forgot & Reset Password
########################################################

# 1. Request Reset Link
POST http://localhost:8080/api/v1/auth/forgot-password
Content-Type: application/json

{
    "email": "newuser@pmrgsolution.com"
}

###

# 2. Reset Password using the token received in email console log
POST http://localhost:8080/api/v1/auth/reset-password
Content-Type: application/json

{
    "token": "YOUR_PASSWORD_RESET_TOKEN_FROM_LOGS",
    "new_password": "AnotherSecurePassword@123"
}

###

########################################################
### Refresh Token Rotation
########################################################

POST http://localhost:8080/api/v1/auth/refresh
Content-Type: application/json

{
    "refresh_token": "YOUR_REFRESH_TOKEN_HERE"
}

###

########################################################
### Enable MFA (Requires Access Token)
########################################################

POST http://localhost:8080/api/v1/auth/mfa/enable
Content-Type: application/json
Authorization: Bearer YOUR_ACCESS_TOKEN_HERE

{
    "method": "email"
}

###

########################################################
### Verify MFA (During Login if MFA is Enabled)
########################################################

POST http://localhost:8080/api/v1/auth/mfa/verify
Content-Type: application/json

{
    "mfa_pending_token": "YOUR_MFA_PENDING_TOKEN_FROM_LOGIN",
    "otp": "123456"
}

###

########################################################
### Disable MFA (Requires Access Token)
########################################################

POST http://localhost:8080/api/v1/auth/mfa/disable
Content-Type: application/json
Authorization: Bearer YOUR_ACCESS_TOKEN_HERE

###

########################################################
### Commercial Estimation: Get Commercial Estimation (Lazy Init)
########################################################

GET http://localhost:8080/api/v1/leads/L-1001/commercial?currency=INR
Authorization: Bearer YOUR_ACCESS_TOKEN_HERE

###

########################################################
### Commercial Estimation: Update / Save Commercial Details
########################################################

PATCH http://localhost:8080/api/v1/leads/L-1001/commercial?currency=INR
Content-Type: application/json
Authorization: Bearer YOUR_ACCESS_TOKEN_HERE

{
    "currency": "USD",
    "billingType": "T&M",
    "startDate": "2026-09-01",
    "estimatedDurationMonths": 6,
    "estimatedEndDate": "2027-03-01",
    "markupPercent": 20.0,
    "discountPercent": 5.0,
    "manualSellingPrice": null,
    "status": "DRAFT",
    "resources": [
        {
            "role": "Tech Lead",
            "grade": "L3",
            "onsiteDays": 20,
            "offshoreDays": 100,
            "dailyCost": 450.0,
            "billingRate": 800.0
        },
        {
            "role": "Senior Developer",
            "grade": "L2",
            "onsiteDays": 0,
            "offshoreDays": 100,
            "dailyCost": 300.0,
            "billingRate": 600.0
        }
    ],
    "expenses": [
        {
            "expenseType": "Travel",
            "cost": 5000.0,
            "remarks": "Onsite Kickoff"
        },
        {
            "expenseType": "Cloud Hosting",
            "cost": 3000.0,
            "remarks": "AWS Dev Cluster"
        }
    ],
    "sdlcAllocations": [
        {
            "phase": "Requirements",
            "manDays": 20
        },
        {
            "phase": "Design",
            "manDays": 20
        },
        {
            "phase": "Development",
            "manDays": 120
        },
        {
            "phase": "Testing",
            "manDays": 40
        },
        {
            "phase": "Deployment",
            "manDays": 20
        }
    ]
}

###

########################################################
### Commercial Estimation: Get Unified Analytics
########################################################

GET http://localhost:8080/api/v1/leads/L-1001/commercial/analytics?currency=INR
Authorization: Bearer YOUR_ACCESS_TOKEN_HERE

###

########################################################
### Dashboard: Get Summary (KPIs & Distributions)
########################################################

# 1. Global Dashboard Summary
GET http://localhost:8080/api/v1/dashboard/summary
Authorization: Bearer YOUR_ACCESS_TOKEN_HERE

###

# 2. Dashboard Summary Filtered by Owner and Region
GET http://localhost:8080/api/v1/dashboard/summary?owner=D.%20Ghosh&region=North%20America
Authorization: Bearer YOUR_ACCESS_TOKEN_HERE

###

########################################################
### Reports: Get Analytics
########################################################

# 1. Default Reports Analytics (Current Period vs Previous Period)
GET http://localhost:8080/api/v1/reports/analytics
Authorization: Bearer YOUR_ACCESS_TOKEN_HERE

###

# 2. Reports Analytics Filtered by Date Range & Owner
GET http://localhost:8080/api/v1/reports/analytics?date_from=2026-01-01&date_to=2026-12-31&owner=S.%20Mishra
Authorization: Bearer YOUR_ACCESS_TOKEN_HERE
